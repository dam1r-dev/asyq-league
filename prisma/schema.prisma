generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  displayName  String
  university   String?
  saqaSkin     String     @default("saqa-classic")
  fieldSkin    String     @default("field-aula")
  /// Внешность персонажа (JSON): кожа, глаза, волосы, одежда, головной убор, цвет.
  avatar       String?
  /// Растёт при выходе: все ранее выданные токены перестают действовать.
  sessionVersion Int      @default(0)
  createdAt    DateTime   @default(now())
  attempts     Attempt[]
  purchases    Purchase[]
  coins        CoinTx[]
}

/// Один сыгранный раунд. Храним броски, а очки пересчитывает сервер.
model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "level" | "daily"
  kind       String
  levelId    String
  /// Дата испытания дня (YYYY-MM-DD по Алматы), для обычных уровней пусто.
  dayKey     String?
  score      Int
  stars      Int
  won        Boolean
  throwsUsed Int
  knocked    Int
  inputs     String
  createdAt  DateTime @default(now())

  @@index([userId, levelId])
  @@index([dayKey, score])
  @@index([createdAt])
}

/// Покупка в тестовом режиме: реальных денег нет, но доступ выдаётся по-настоящему.
model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  /// Цена в тиынах (внутриигровая валюта).
  priceKzt  Int
  testMode  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

/// Движение тиынов (внутриигровой валюты). Баланс = сумма amount.
/// refKey уникален, поэтому одну и ту же награду нельзя получить дважды.
model CoinTx {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  /// welcome | star | daily-play | daily-rank | purchase | demo-refill
  reason    String
  refKey    String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Счётчики ограничения частоты запросов (ключ = маршрут + IP/логин).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Онлайн-дуэль по ссылке. Хранятся только броски: состояние поля любой
/// клиент и сервер получают детерминированным проигрыванием этих бросков.
model Match {
  id          String   @id @default(cuid())
  /// Короткий код из ссылки /m/CODE.
  code        String   @unique
  hostName    String
  guestName   String?
  /// Режим: classic | five.
  mode        String   @default("classic")
  /// Устарело: одно своё поле (заменено на rounds). Читается для старых матчей.
  field       String?
  /// Бросков подряд за один ход (1–5).
  perTurn     Int      @default(1)
  /// Раунды матча: JSON-массив кодов полей из редактора (null — стандартное поле).
  rounds      String?
  /// Секреты игроков: по ним сервер узнаёт, кто делает ход.
  hostToken   String
  guestToken  String?
  hostUserId  String?
  guestUserId String?
  /// JSON-массив бросков в порядке ходов.
  inputs      String   @default("[]")
  /// waiting | playing | finished
  status      String   @default("waiting")
  /// 0 — хозяин, 1 — гость, -1 — ничья.
  winner      Int?
  /// played | timeout | left
  endReason   String?
  /// Счётчик версий: защита от одновременных записей.
  version     Int      @default(0)
  lastMoveAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
